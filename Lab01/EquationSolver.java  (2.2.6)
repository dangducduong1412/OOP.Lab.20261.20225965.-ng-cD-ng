import javax.swing.JOptionPane;

public class EquationSolver {
    public static void main(String[] args) {
        String menu = "CHỌN CHƯƠNG TRÌNH GIẢI PHƯƠNG TRÌNH:\n"
                    + "1. Phương trình bậc 1 một ẩn (ax + b = 0)\n"
                    + "2. Hệ phương trình bậc 1 hai ẩn\n"
                    + "3. Phương trình bậc 2 một ẩn (ax^2 + bx + c = 0)\n"
                    + "0. Thoát";
        
        while (true) {
            String choice = JOptionPane.showInputDialog(null, menu, "Menu Giải Phương Trình", JOptionPane.INFORMATION_MESSAGE);
            if (choice == null || choice.equals("0")) {
                break; // Thoát chương trình
            }
            
            switch (choice) {
                case "1":
                    solveLinearEquation();
                    break;
                case "2":
                    solveLinearSystem();
                    break;
                case "3":
                    solveQuadraticEquation();
                    break;
                default:
                    JOptionPane.showMessageDialog(null, "Lựa chọn không hợp lệ. Vui lòng nhập lại!");
            }
        }
        System.exit(0);
    }

    // 1. Giải phương trình bậc 1: ax + b = 0
    private static void solveLinearEquation() {
        String strA = JOptionPane.showInputDialog("Giải phương trình ax + b = 0\nNhập hệ số a:");
        String strB = JOptionPane.showInputDialog("Nhập hệ số b:");
        double a = Double.parseDouble(strA);
        double b = Double.parseDouble(strB);

        if (a == 0) {
            if (b == 0) {
                JOptionPane.showMessageDialog(null, "Phương trình có vô số nghiệm.");
            } else {
                JOptionPane.showMessageDialog(null, "Phương trình vô nghiệm.");
            }
        } else {
            double x = -b / a;
            JOptionPane.showMessageDialog(null, "Nghiệm của phương trình là x = " + x);
        }
    }

    // 2. Giải hệ phương trình bậc 1 hai ẩn (Dùng định thức Cramer)
    private static void solveLinearSystem() {
        JOptionPane.showMessageDialog(null, "Giải hệ phương trình:\na11*x1 + a12*x2 = b1\na21*x1 + a22*x2 = b2");
        double a11 = Double.parseDouble(JOptionPane.showInputDialog("Nhập a11:"));
        double a12 = Double.parseDouble(JOptionPane.showInputDialog("Nhập a12:"));
        double b1 = Double.parseDouble(JOptionPane.showInputDialog("Nhập b1:"));
        double a21 = Double.parseDouble(JOptionPane.showInputDialog("Nhập a21:"));
        double a22 = Double.parseDouble(JOptionPane.showInputDialog("Nhập a22:"));
        double b2 = Double.parseDouble(JOptionPane.showInputDialog("Nhập b2:"));

        double D = a11 * a22 - a21 * a12;
        double D1 = b1 * a22 - b2 * a12;
        double D2 = a11 * b2 - a21 * b1;

        if (D != 0) {
            double x1 = D1 / D;
            double x2 = D2 / D;
            JOptionPane.showMessageDialog(null, "Hệ phương trình có nghiệm duy nhất:\nx1 = " + x1 + "\nx2 = " + x2);
        } else {
            if (D1 == 0 && D2 == 0) {
                JOptionPane.showMessageDialog(null, "Hệ phương trình có vô số nghiệm.");
            } else {
                JOptionPane.showMessageDialog(null, "Hệ phương trình vô nghiệm.");
            }
        }
    }

    // 3. Giải phương trình bậc 2: ax^2 + bx + c = 0
    private static void solveQuadraticEquation() {
        String strA = JOptionPane.showInputDialog("Giải phương trình ax^2 + bx + c = 0\nNhập hệ số a:");
        double a = Double.parseDouble(strA);
        
        if (a == 0) {
            JOptionPane.showMessageDialog(null, "Hệ số a = 0, đây trở thành phương trình bậc 1.\nVui lòng dùng chức năng số 1.");
            return;
        }

        double b = Double.parseDouble(JOptionPane.showInputDialog("Nhập hệ số b:"));
        double c = Double.parseDouble(JOptionPane.showInputDialog("Nhập hệ số c:"));

        double delta = b * b - 4 * a * c;

        if (delta < 0) {
            JOptionPane.showMessageDialog(null, "Phương trình vô nghiệm (Delta < 0).");
        } else if (delta == 0) {
            double x = -b / (2 * a);
            JOptionPane.showMessageDialog(null, "Phương trình có nghiệm kép:\nx = " + x);
        } else {
            double x1 = (-b + Math.sqrt(delta)) / (2 * a);
            double x2 = (-b - Math.sqrt(delta)) / (2 * a);
            JOptionPane.showMessageDialog(null, "Phương trình có 2 nghiệm phân biệt:\nx1 = " + x1 + "\nx2 = " + x2);
        }
    }
}
